<script>
const INTERVALO_ATUALIZACAO_MS = 3000;
let cacheLeituras = [];
let cacheStats = null;
let modoCadastro = false;

// Recupera a sessão salva no navegador para não perder o ID se der F5
let usuarioLogado = JSON.parse(localStorage.getItem('ecosense_user')) || {
  id: null,
  email: '',
  cep: '',
  tarifa: 0.85,
  limite_watts: 500.0
};

function goTo(nome){
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  const el = document.getElementById('screen-' + nome);
  if (el) el.classList.add('active');
  window.scrollTo(0,0);
}

function goToView(nome){
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  const el = document.getElementById('view-' + nome);
  if (el) el.classList.add('active');
  
  document.querySelectorAll('.nav-link').forEach(b => b.classList.remove('active'));
  const link = document.querySelector(`.nav-link[data-view="${nome}"]`);
  if (link) link.classList.add('active');
  
  const nav = document.getElementById('navbar');
  if (nav) nav.classList.remove('nav-open');
  window.scrollTo(0,0);
}

document.addEventListener('DOMContentLoaded', () => {

  // 1. Olho da senha
  const toggleSenhaEl = document.getElementById('toggle-senha');
  if (toggleSenhaEl) {
    toggleSenhaEl.addEventListener('click', function() {
      const campo = document.getElementById('auth-senha');
      if (!campo) return;
      if (campo.type === 'password') {
        campo.type = 'text';
        this.textContent = '🙈';
      } else {
        campo.type = 'password';
        this.textContent = '👁️';
      }
    });
  }

  // 2. Alternar Login / Cadastro
  const authToggleBtn = document.getElementById('auth-toggle-btn');
  if (authToggleBtn) {
    authToggleBtn.addEventListener('click', () => {
      modoCadastro = !modoCadastro;
      const campoCep = document.getElementById('campo-cep');
      const authCep = document.getElementById('auth-cep');
      const btnSubmit = document.getElementById('btn-auth-submit');
      const toggleText = document.getElementById('auth-toggle-text');

      if (campoCep) campoCep.style.display = modoCadastro ? 'block' : 'none';
      if (authCep) authCep.required = modoCadastro;
      if (btnSubmit) btnSubmit.textContent = modoCadastro ? 'Criar Conta' : 'Entrar';
      if (toggleText) toggleText.textContent = modoCadastro ? 'Já possui conta?' : 'Não tem conta?';
      authToggleBtn.textContent = modoCadastro ? 'Entrar' : 'Cadastre-se';
    });
  }

  // 3. Submissão de Formulário (Login / Cadastro)
  const formAuth = document.getElementById('form-auth');
  if (formAuth) {
    formAuth.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = document.getElementById('auth-email').value;
      const senha = document.getElementById('auth-senha').value;
      const cep = document.getElementById('auth-cep').value;

      const url = modoCadastro ? '/api/cadastrar' : '/api/login';
      const payload = modoCadastro ? { email, senha, cep } : { email, senha };

      try {
        const res = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();

        if (!res.ok) {
          alert(data.erro || 'Erro na autenticação');
          return;
        }

        if (modoCadastro) {
          alert('Conta criada com sucesso! Agora faça o login.');
          const toggle = document.getElementById('auth-toggle-btn');
          if (toggle) toggle.click();
        } else {
          usuarioLogado = {
            id: data.id,
            email: data.email,
            cep: data.cep,
            tarifa: data.tarifa || 0.85,
            limite_watts: data.limite_watts || 500.0
          };

          // Salva no navegador para nunca mais ficar com id null
          localStorage.setItem('ecosense_user', JSON.stringify(usuarioLogado));

          // Preenche os campos da aba de configurações
          if (document.getElementById('cfg-email')) document.getElementById('cfg-email').value = usuarioLogado.email;
          if (document.getElementById('cfg-cep')) document.getElementById('cfg-cep').value = usuarioLogado.cep;
          if (document.getElementById('cfg-tarifa')) document.getElementById('cfg-tarifa').value = usuarioLogado.tarifa;
          if (document.getElementById('cfg-limite')) document.getElementById('cfg-limite').value = usuarioLogado.limite_watts;

          goTo('app');
          goToView('dashboard');
          atualizarTudo();
          setInterval(atualizarTudo, INTERVALO_ATUALIZACAO_MS);
        }
      } catch (err) {
        alert('Erro ao se comunicar com o servidor da Raspberry Pi.');
      }
    });
  }

// 4. Buscar e Atualizar Tarifa pelo CEP na aba Configurações
  const btnRecalc = document.getElementById('btn-recalc-cep');
  if (btnRecalc) {
    btnRecalc.addEventListener('click', async () => {
      const cep = document.getElementById('cfg-cep').value.replace(/\D/g, '').trim();
      if (cep.length !== 8) {
        alert('Digite um CEP válido com 8 dígitos (ex: 37540000).');
        return;
      }
      try {
        const r = await fetch(`/api/tarifa-cep?cep=${cep}`);
        const d = await r.json();
        if (d.erro) {
          alert(d.erro);
          return;
        }

        // Atualiza campos visuais da aba Configurações
        document.getElementById('cfg-tarifa').value = d.tarifa_kwh;

        // Atualiza a sessão local
        usuarioLogado.tarifa = d.tarifa_kwh;
        usuarioLogado.cep = cep;
        localStorage.setItem('ecosense_user', JSON.stringify(usuarioLogado));

        // Salva direto no banco de dados do usuário se estiver logado
        if (usuarioLogado.id) {
          await fetch('/api/usuario/atualizar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              id: usuarioLogado.id,
              email: usuarioLogado.email,
              cep: cep,
              tarifa: d.tarifa_kwh,
              limite_watts: usuarioLogado.limite_watts
            })
          });
        }

        alert(`Localizado: ${d.cidade}/${d.uf} (${d.empresa})\nTarifa aplicada com sucesso: R$ ${d.tarifa_kwh.toFixed(2)}/kWh`);
        renderDashboard();
      } catch (e) {
        alert('Erro ao buscar o CEP.');
      }
    });
  }
        alert(`Localizado: ${d.cidade}/${d.uf} (${d.empresa})\nTarifa aplicada com sucesso: R$ ${d.tarifa_kwh.toFixed(2)}/kWh`);
        renderDashboard();
      } catch (e) {
        alert('Erro ao buscar o CEP.');
      }
    });
  }

  // 5. Salvar Preferências de Tarifa / Limite
  const btnSalvarTarifa = document.getElementById('btn-salvar-tarifa');
  if (btnSalvarTarifa) {
    btnSalvarTarifa.addEventListener('click', async () => {
      const payload = {
        id: usuarioLogado.id,
        email: usuarioLogado.email,
        cep: document.getElementById('cfg-cep').value,
        tarifa: parseFloat(document.getElementById('cfg-tarifa').value),
        limite_watts: parseFloat(document.getElementById('cfg-limite').value)
      };
      await atualizarPerfil(payload, 'Preferências de consumo salvas com sucesso!');
    });
  }

  // 6. Salvar Dados de Acesso (E-mail / Senha)
  const btnSalvarAcesso = document.getElementById('btn-salvar-acesso');
  if (btnSalvarAcesso) {
    btnSalvarAcesso.addEventListener('click', async () => {
      const payload = {
        id: usuarioLogado.id,
        email: document.getElementById('cfg-email').value,
        senha: document.getElementById('cfg-senha').value
      };
      await atualizarPerfil(payload, 'Dados de acesso atualizados!');
      document.getElementById('cfg-senha').value = '';
    });
  }

  // 7. Zerar Leituras
  const btnLimpar = document.getElementById('btn-limpar-leituras');
  if (btnLimpar) {
    btnLimpar.addEventListener('click', async () => {
      if (!confirm('Deseja realmente zerar todo o histórico de medições?')) return;
      try {
        const r = await fetch('/api/leituras/limpar', { 
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        if (r.ok) {
          cacheLeituras = [];
          if (cacheStats) {
            cacheStats.kwh_hoje = 0.0;
            cacheStats.custo_hoje = 0.0;
            cacheStats.media = 0.0;
            cacheStats.maximo = 0.0;
            cacheStats.minimo = 0.0;
            cacheStats.ultima_potencia = 0.0;
            cacheStats.ultima_corrente = 0.0;
          }
          alert('Histórico de medições e consumo acumulado zerados com sucesso!');
          atualizarTudo();
        }
      } catch (e) {
        alert('Erro ao zerar histórico.');
      }
    });
  }

  // 8. Logout
  const btnLogout = document.getElementById('btn-logout');
  if (btnLogout) {
    btnLogout.addEventListener('click', () => {
      localStorage.removeItem('ecosense_user');
      usuarioLogado = { id: null, email: '', cep: '', tarifa: 0.85, limite_watts: 500.0 };
      goTo('login');
    });
  }

  // 9. Excluir Conta
  const btnExcluir = document.getElementById('btn-excluir-conta');
  if (btnExcluir) {
    btnExcluir.addEventListener('click', async () => {
      if (!confirm('Tem certeza de que deseja excluir permanentemente sua conta?')) return;
      try {
        const r = await fetch('/api/usuario/excluir', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: usuarioLogado.id })
        });
        if (r.ok) {
          alert('Conta excluída com sucesso.');
          goTo('login');
        }
      } catch (e) {
        alert('Erro ao excluir conta.');
      }
    });
  }

  // 10. Botão da Feira: Simular Pico de 1500W
  const btnPico = document.getElementById('btn-simular-pico');
  if (btnPico) {
    btnPico.addEventListener('click', async () => {
      try {
        const r = await fetch('/api/simular-pico', { 
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const d = await r.json();
        btnPico.textContent = d.simulando_pico ? '🟢 Desativar Simulação (Voltar ao Normal)' : '⚡ Simular Carga Alta (1500W)';
        alert(d.mensagem);
        atualizarTudo();
      } catch (e) {
        alert('Erro ao acionar simulação de pico.');
      }
    });
  }
  // Suporte
  const formSupport = document.getElementById('form-support');
  if (formSupport) {
    formSupport.addEventListener('submit', function(e){
      e.preventDefault();
      const conf = document.getElementById('support-confirm');
      if (conf) conf.style.display = 'block';
    });
  }

  renderLearn();
});

async function atualizarPerfil(payload, msgSucesso) {
  if (!payload.id) {
    alert('Sessão expirada. Faça login novamente para atualizar suas configurações.');
    goTo('login');
    return;
  }
  try {
    const res = await fetch('/api/usuario/atualizar', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await res.json();
    if (res.ok) {
      usuarioLogado.email = data.email;
      usuarioLogado.cep = data.cep;
      usuarioLogado.tarifa = data.tarifa;
      usuarioLogado.limite_watts = data.limite_watts;
      localStorage.setItem('ecosense_user', JSON.stringify(usuarioLogado));
      alert(msgSucesso);
      renderDashboard();
    } else {
      alert(data.erro || 'Falha ao salvar');
    }
  } catch (err) {
    alert('Erro ao conectar com o servidor.');
  }
}

async function buscarLeituras(){
  try{ 
    const r = await fetch('/api/leituras'); 
    if (r.ok) cacheLeituras = await r.json(); 
  } catch(e){ console.error('Erro ao buscar leituras:', e); }
}

async function buscarStats(){
  try{ 
    const r = await fetch('/api/stats'); 
    if (r.ok) cacheStats = await r.json(); 
  } catch(e){ console.error('Erro ao buscar stats:', e); }
}

function media(l){ return l.length ? l.reduce((s,n)=>s+n,0)/l.length : 0; }
function maximo(l){ return l.length ? Math.max(...l) : 0; }
function minimo(l){ return l.length ? Math.min(...l) : 0; }
function fmtW(v){ return (v || 0).toFixed(2)+' W'; }
function fmtA(v){ return (v || 0).toFixed(2)+' A'; }

let modoHero = 'potencia'; // 'potencia', 'tensao' ou 'corrente'

function trocarModoHero(novoModo) {
  modoHero = novoModo;
  ['potencia', 'tensao', 'corrente'].forEach(m => {
    const btn = document.getElementById('btn-show-' + m);
    if (btn) {
      if (m === modoHero) {
        btn.style.background = 'var(--cream-2)';
        btn.style.color = 'var(--bg-darker)';
      } else {
        btn.style.background = 'rgba(245,233,211,.15)';
        btn.style.color = 'var(--cream-2)';
      }
    }
  });
  renderDashboard();
}

function alternarModoHero() {
  if (modoHero === 'potencia') trocarModoHero('tensao');
  else if (modoHero === 'tensao') trocarModoHero('corrente');
  else trocarModoHero('potencia');
}
function renderDashboard(){
  if (!cacheStats) return;
  const p = document.getElementById('dash-power');
  const c = document.getElementById('dash-current');
  const k = document.getElementById('dash-kwh');
  const cost = document.getElementById('dash-cost');
  const avg = document.getElementById('dash-avg');
  const maxEl = document.getElementById('dash-max');
  const tip = document.getElementById('dash-tip');
  const heroCard = document.getElementById('hero-card');
  const alertBanner = document.getElementById('alert-banner-potencia');
  const alertVal = document.getElementById('alert-limite-val');

  const potenciaAtual = cacheStats.ultima_potencia || 0.0;
  const tensaoAtual = cacheStats.ultima_tensao || 227.0;
  const correnteAtual = cacheStats.ultima_corrente || 0.80;
  const limiteWatts = cacheStats.limite_alerta || usuarioLogado.limite_watts || 500.0;

  // Atualiza o valor principal conforme a aba selecionada
  const heroTag = document.getElementById('hero-modo-tag');
  if (p) {
    if (modoHero === 'potencia') {
      p.textContent = fmtW(potenciaAtual);
      if (heroTag) heroTag.textContent = 'POTÊNCIA';
    } else if (modoHero === 'tensao') {
      p.textContent = tensaoAtual.toFixed(1) + ' V';
      if (heroTag) heroTag.textContent = 'TENSÃO';
    } else {
      p.textContent = fmtA(correnteAtual);
      if (heroTag) heroTag.textContent = 'CORRENTE';
    }
  }

  // Linha de detalhe secundária com todos os valores explícitos
  if (c) {
    c.innerHTML = `⚡ ${fmtW(potenciaAtual)} · 🔌 ${tensaoAtual.toFixed(1)} V · 🔋 ${fmtA(correnteAtual)}`;
  }
  if (k) k.textContent = (cacheStats.kwh_hoje || 0).toFixed(2) + ' kWh';
  if (cost) cost.textContent = 'R$ ' + (cacheStats.custo_hoje || 0).toFixed(2).replace('.', ',');
  if (avg) avg.textContent = fmtW(cacheStats.media);
  if (maxEl) maxEl.textContent = fmtW(cacheStats.maximo);

  // Exibe informações da concessionária e tarifa no painel
  const concInfo = document.getElementById('dash-concessionaria-info');
  if (concInfo) {
    concInfo.textContent = `Tarifa: R$ ${(usuarioLogado.tarifa || 0.85).toFixed(2)}/kWh (${usuarioLogado.cep ? 'CEP ' + usuarioLogado.cep : 'Padrão'})`;
  }

  // Atualiza status dinâmico do sensor (físico vs simulação)
  const sensorText = document.getElementById('status-sensor-text');
  const sensorDot = document.getElementById('status-sensor-dot');
  if (sensorText && sensorDot) {
    if (cacheStats.sensor_conectado) {
      sensorText.textContent = "Sensor conectado";
      sensorDot.style.background = "var(--ok)"; // Verde
    } else {
      sensorText.textContent = "Modo Simulação (Sem ESP32)";
      sensorDot.style.background = "#9CA3AF"; // Cinza
    }
  }

  // Alerta Visual de Consumo Alto
  if (potenciaAtual > limiteWatts) {
    if (heroCard) heroCard.classList.add('alerta-ativo');
    if (alertBanner) alertBanner.style.display = 'block';
    if (alertVal) alertVal.textContent = limiteWatts;
    if (tip) tip.textContent = '⚠️ ALTO CONSUMO: Potência acima do seu limite configurado! Verifique aquecedores, ferros ou chuveiros.';
  } else {
    if (heroCard) heroCard.classList.remove('alerta-ativo');
    if (alertBanner) alertBanner.style.display = 'none';
    if (tip) {
      tip.textContent = potenciaAtual > (cacheStats.media || 0)
        ? 'Sua potência atual está acima da média. Vale checar quais aparelhos estão ligados.'
        : 'Seu consumo atual está estável e dentro da faixa normal.';
    }
  }

  const el = document.getElementById('dash-bars');
  const ultimas = cacheLeituras.slice(-20);
  const scaleMax = document.getElementById('dash-scale-max');
  const scaleMid = document.getElementById('dash-scale-mid');

  if (el && ultimas.length){
    const potencias = ultimas.map(l => l.potencia);
    const maxVal = Math.max(...potencias, 10);

    if (scaleMax) scaleMax.textContent = maxVal.toFixed(0) + ' W';
    if (scaleMid) scaleMid.textContent = (maxVal / 2).toFixed(0) + ' W';

    el.innerHTML = ultimas.map((l, i) => {
      const h = Math.max(6, Math.round((l.potencia / maxVal) * 100));
      const hora = l.timestamp ? l.timestamp.substring(11, 19) : `#${i + 1}`;
      return `
        <div class="bar-col" style="cursor:pointer;" 
             onclick="alert('📊 Leitura ${i + 1}\\nHora: ${hora}\\nPotência: ${l.potencia.toFixed(1)} W\\nCorrente: ${l.corrente.toFixed(3)} A')" 
             title="Clique para detalhes: ${l.potencia.toFixed(1)} W">
          <div class="bar" style="height:${h}%; background: var(--ok-2); border-radius: 3px 3px 0 0;"></div>
        </div>`;
    }).join('');
  }
}
function setReportTab(tipo){
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  const b = document.querySelector(`.tab[data-rep="${tipo}"]`);
  if (b) b.classList.add('active');
  renderReportChart(tipo);
}

async function renderReportChart(tipo) {
  const container = document.getElementById('rep-bars');
  const tabelaCorpo = document.getElementById('rep-tabela-corpo');
  const titleEl = document.getElementById('rep-chart-title');
  if (!container) return;

  let labels = [], valores = [], custos = [], datas = [], explicacao = '';

  if (tipo === 'diario') {
    titleEl.textContent = 'Leituras em Tempo Real da Bancada (Watts)';
    const ultimas = cacheLeituras.slice(-14);
    if (ultimas.length === 0) {
      valores = [0];
      labels = ['Aguardando'];
      datas = ['--:--:--'];
      custos = ['R$ 0,00'];
      explicacao = 'Nenhuma leitura registrada ainda. Ligue a bancada para iniciar a medição.';
    } else {
      valores = ultimas.map(l => l.potencia);
      labels = ultimas.map((_, i) => `${i + 1}ª`);
      datas = ultimas.map(l => (l.timestamp ? l.timestamp.substring(11, 19) : '--:--:--'));
      custos = valores.map(v => 'R$ ' + ((v / 1000) * (usuarioLogado.tarifa || 0.85)).toFixed(3));
      explicacao = 'Variação instantânea registrada pelas medições dos sensores na bancada.';
    } else {
    titleEl.textContent = 'Consumo Semanal Consolidado (kWh)';
    try {
      const res = await fetch('/api/historico-semanal');
      const dados = await res.json();
      labels = dados.map(d => d.dia);
      valores = dados.map(d => d.kwh);
      datas = dados.map(d => d.data);
      custos = dados.map(d => 'R$ ' + d.custo.toFixed(2));
      explicacao = 'Consumo dos últimos 7 dias baseado na data do calendário e tarifa configurada.';
    } catch (e) {
      console.error('Erro ao buscar histórico semanal:', e);
    }
  }

  const max = Math.max(...valores, 1);
  const unidade = tipo === 'diario' ? 'W' : 'kWh';

  container.innerHTML = valores.map((v, i) => {
    const h = Math.max(8, Math.round((v / max) * 100));
    return `
      <div class="bar-col" style="position: relative;" title="${datas[i]} - ${v} ${unidade}">
        <span style="font-size: 10px; font-weight: bold; color: var(--cream-2); margin-bottom: 4px;">${v > 0 ? v : '0'}</span>
        <div class="bar" style="height:${h}%; background: var(--ok-2); width: 85%; border-radius: 4px 4px 0 0;"></div>
        <div class="bar-label" style="margin-top: 6px; font-size: 10px;">${labels[i]}</div>
      </div>`;
  }).join('');

  if (tabelaCorpo) {
    tabelaCorpo.innerHTML = valores.map((v, i) => `
      <tr style="border-bottom: 1px solid rgba(245,233,211,0.06);">
        <td style="padding: 6px 4px; font-weight: 500;">${datas[i]} <span style="font-size: 10px; color: var(--white-7);">(${labels[i]})</span></td>
        <td style="padding: 6px 4px; color: #10B981; font-weight: 600;">${v} ${unidade}</td>
        <td style="padding: 6px 4px; color: var(--cream);">${custos[i]}</td>
      </tr>
    `).join('');
  }

  const rAvg = document.getElementById('rep-avg');
  const rMax = document.getElementById('rep-max');
  const rMin = document.getElementById('rep-min');
  const rExp = document.getElementById('rep-explainer');

  if (rAvg) rAvg.textContent = tipo === 'diario' ? fmtW(media(valores)) : media(valores).toFixed(2) + ' kWh';
  if (rMax) rMax.textContent = tipo === 'diario' ? fmtW(maximo(valores)) : maximo(valores).toFixed(2) + ' kWh';
  if (rMin) rMin.textContent = tipo === 'diario' ? fmtW(minimo(valores)) : minimo(valores).toFixed(2) + ' kWh';
  if (rExp) rExp.textContent = explicacao;
}

