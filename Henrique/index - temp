      <!-- ---- SETTINGS (CONFIGURAÇÕES) ---- -->
      <section id="view-settings" class="view">
        <div class="page-head"><h1>Configurações do Usuário</h1><p>Gerencie sua localização, tarifas e segurança da conta.</p></div>

        <div class="grid grid-2col" style="margin-bottom: 24px;">
          <!-- Card de Localização e Tarifa -->
          <div class="card">
            <b style="font-size: 16px; display: block; margin-bottom: 16px;">📍 Localização & Tarifa de Energia</b>
            <div class="field">
              <label>CEP da Residência</label>
              <div style="display: flex; gap: 8px;">
                <input type="text" id="cfg-cep" placeholder="37540-000" maxlength="9">
                <button type="button" class="btn-secondary" id="btn-recalc-cep" style="white-space: nowrap;">Buscar CEP</button>
              </div>
            </div>
            <div class="field">
              <label>Tarifa Personalizada (R$/kWh)</label>
              <input type="number" step="0.01" id="cfg-tarifa" placeholder="0.85">
            </div>
            <div class="field">
              <label>Limite de Alerta de Alto Consumo (Watts)</label>
              <input type="number" step="10" id="cfg-limite" placeholder="500">
            </div>
            <button class="btn-primary" id="btn-salvar-tarifa" type="button" style="height: 44px; margin-top: 8px;">Salvar Preferências</button>
