# Inicializa o cliente oficial do Gemini
from google.genai import types

client = genai.Client(api_key=CHAVE_API, http_options={'headers': {'x-goog-api-key': CHAVE_API}})


def gerar_dica_economia(historico_consumo):
    """
    Função de Back-end que envia os dados do sensor para o Gemini
    e retorna uma dica curta de economia para a tela do monitor.
    """
    contexto_prompt = f"""
    Você é um assistente de casa inteligente focado em economia de energia.
    Analise o seguinte histórico de consumo de um aparelho na tomada de testes e dê uma dica de economia CURTA, DIRETA e HUMANIZADA (no máximo 2 linhas) para o usuário na feira de tecnologia.

    Histórico de consumo enviado pelo sensor:
    {historico_consumo}
    """

    try:
        # Faz a chamada para o modelo rápido e gratuito 'gemini-flash-latest'
        resposta = client.models.generate_content(
        model='gemini-flash-latest',
            contents=contexto_prompt,
        )
        return resposta.text
    except Exception as e:
        # Plano B caso falte internet ou dê erro na feira
        return "Dica do momento: Evite manter aparelhos potentes ligados sem necessidade! (Erro de conexão)"


