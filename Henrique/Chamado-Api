import serial

# Verifique se a ESP32 está na /dev/ttyUSB0 ou /dev/ttyACM0
porta = '/dev/ttyUSB0' 

try:
    esp = serial.Serial(porta, 115200, timeout=1)
    print(f"Lendo dados em tempo real da ESP32 em {porta}...")
    while True:
        if esp.in_waiting > 0:
            linha = esp.readline().decode('utf-8', errors='ignore').strip()
            if linha:
                print(f"Dado direto da ESP32: {linha}")
except Exception as e:
    print(f"Erro ao abrir serial ({porta}): {e}")
