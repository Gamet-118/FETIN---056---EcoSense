import sqlite3
import time
import datetime
from google import genai
from google.genai import types

# =====================================================
# CONFIGURAÇÕES
# =====================================================
API_KEY = "AQ.Ab8RN6K5HQa0BlLmQOGXS5yXk8pRgR09rTOzEJ8nYzTMQWmEug"
DB_PATH = "/home/pedro/ProjetoEnergia/banco/energia.db"

# Deixe None para usar o horário real da Raspberry
HORARIO_TESTE = None 

client = genai.Client(api_key=API_KEY)

# =====================================================
# FUNÇÃO PARA LER A ÚLTIMA LEITURA DO BANCO
# =====================================================
def obter_ultima_leitura():
    try:
        conn = sqlite3.connect(DB_PATH)
        cursor = conn.cursor()

        cursor.execute("""
            SELECT
                corrente,
                tensao,
                potencia,
                energia,
                dispositivo,
                data_hora
            FROM leituras
            ORDER BY id DESC
            LIMIT 1
        """)

        resultado = cursor.fetchone()
        conn.close()
        return resultado
    except Exception as e:
        print(f"Erro ao acessar o banco: {e}")
        return None

# =====================================================
# LOOP PRINCIPAL
# =====================================================
print("=========================================")
print("EcoSense iniciado")
print("=========================================")

try:
    while True:
        leitura = obter_ultima_leitura()

        # Determina a hora atual
        if HORARIO_TESTE is None:
            hora_atual = datetime.datetime.now().strftime("%H:%M:%S")
        else:
            hora_atual = HORARIO_TESTE

        if leitura:
            corrente, tensao, potencia, energia, dispositivo, data_banco = leitura
            data_exibicao = data_banco if data_banco else hora_atual

            dados_sensores = f"""
Data/Hora da Leitura: {data_exibicao}
Dispositivo: {dispositivo}
Corrente: {corrente:.2f} A
Tensão: {tensao:.2f} V
Potência: {potencia:.2f} W
Energia: {energia:.3f} kWh
"""
        else:
            data_exibicao = hora_atual
            print("\n[Aviso] Nenhuma leitura encontrada no banco. Usando dados padrão.")
            dados_sensores = f"""
Data/Hora da Leitura: {data_exibicao}
Dispositivo: ESP32_01
Corrente: 0.00 A
Tensão: 220.00 V
Potência: 0.00 W
Energia: 0.000 kWh
"""

        print("\n===== Dados Atuais =====")
        print(dados_sensores.strip())

        system_instruction = f"""
Você é o EcoSense, um assistente inteligente de eficiência energética.
O horário atual é {hora_atual}.

Diretrizes:
* Horário de pico: entre 18:00 e 21:00.
* Incentive economia de energia com base na potência/corrente.
* Seja objetivo.
* Responda em no máximo três frases.
* Mencione a hora atual ({hora_atual}).
"""

        try:
            response = client.models.generate_content(
                model="gemini-flash-latest",
                contents=f"Analise esta medição elétrica:\n{dados_sensores}",
                config=types.GenerateContentConfig(
                    system_instruction=system_instruction,
                    temperature=0.7
                )
            )

            print("\n========== EcoSense ==========")
            print(response.text)
            print("==============================\n")

        except Exception as e:
            print(f"Erro na API (verifique limite/conexão): {e}")

        # Intervalo de 30 segundos para evitar sobrecarga (erro 429) no plano gratuito
        time.sleep(30)

except KeyboardInterrupt:
    print("\nPrograma encerrado.")
