# =====================================================
# FUNÇÃO PARA LER A ÚLTIMA LEITURA DO BANCO
# =====================================================
def obter_ultima_leitura():
    try:
        conn = sqlite3.connect(DB_PATH)
        cursor = conn.cursor()

        cursor.execute("""
            SELECT
                corrente,
                tensao,
                potencia,
                energia,
                dispositivo,
                data_hora
            FROM leituras
            ORDER BY id DESC
            LIMIT 1
        """)

        resultado = cursor.fetchone()
        conn.close()
        return resultado
    except Exception as e:
        print(f"Erro ao acessar o banco: {e}")
        return None

