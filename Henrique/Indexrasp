let modoCadastro = false;
let tarifaAtualKwh = 0.85;

// Alterna entre tela de Login e tela de Cadastro
document.getElementById('auth-toggle-btn').addEventListener('click', () => {
  modoCadastro = !modoCadastro;
  document.getElementById('campo-cep').style.display = modoCadastro ? 'block' : 'none';
  document.getElementById('auth-cep').required = modoCadastro;
  document.getElementById('btn-auth-submit').textContent = modoCadastro ? 'Criar Conta' : 'Entrar';
  document.getElementById('auth-toggle-text').textContent = modoCadastro ? 'Já possui conta?' : 'Não tem conta?';
  document.getElementById('auth-toggle-btn').textContent = modoCadastro ? 'Entrar' : 'Cadastre-se';
});

// Envio do formulário (Login ou Cadastro)
document.getElementById('form-auth').addEventListener('submit', async (e) => {
  e.preventDefault();
  const email = document.getElementById('auth-email').value;
  const senha = document.getElementById('auth-senha').value;
  const cep = document.getElementById('auth-cep').value;

  const url = modoCadastro ? '/api/cadastrar' : '/api/login';
  const payload = modoCadastro ? { email, senha, cep } : { email, senha };

  try {
    const res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await res.json();

    if (!res.ok) {
      alert(data.erro || 'Erro na autenticação');
      return;
    }

    if (modoCadastro) {
      alert('Cadastro realizado! Faça login com suas credenciais.');
      document.getElementById('auth-toggle-btn').click();
    } else {
      tarifaAtualKwh = data.tarifa;
      goTo('app');
      goToView('dashboard');
    }
  } catch (err) {
    alert('Erro de comunicação com o servidor.');
  }
});
document.getElementById('form-support').addEventListener('submit', function(e){
  e.preventDefault();
  document.getElementById('support-confirm').style.display = 'block';
});
async function atualizarTudo(){
  await Promise.all([buscarLeituras(), buscarStats()]);
  renderDashboard();
  const tabAtiva = document.querySelector('.tab.active');
  renderReportChart(tabAtiva ? tabAtiva.dataset.rep : 'diario');
  renderAlerts();
}

renderLearn();
atualizarTudo();
setInterval(atualizarTudo, INTERVALO_ATUALIZACAO_MS);
</script>
