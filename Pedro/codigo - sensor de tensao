#include <Arduino.h>
#include "EmonLib.h"

EnergyMonitor SCT013;
EnergyMonitor ZMPT101B;

const int   pinSCT         = 34;
const int   pinZMPT        = 35;
const float calSCT         = 0.52;
const float calZMPT        = 23220.0; // ajuste com multímetro de referência
const float limiarCorrente = 0.17;

void setup() {
    Serial.begin(115200);
    analogReadResolution(10);
    SCT013.current(pinSCT, calSCT);
    ZMPT101B.voltage(pinZMPT, calZMPT, 1.7);
    Serial.println("Sistema iniciado.");
}

void loop() {
    ZMPT101B.calcVI(20, 2000);
    double Vrms = ZMPT101B.Vrms;

    double Irms = SCT013.calcIrms(1480);
    if (Irms < limiarCorrente) Irms = 0.0;

    float potencia = Irms * Vrms;

    Serial.print("Tensao   = ");
    Serial.print(Vrms, 2);
    Serial.println(" V");
    Serial.print("Corrente = ");
    Serial.print(Irms, 4);
    Serial.println(" A");
    Serial.print("Potencia = ");
    Serial.print(potencia, 2);
    Serial.println(" W");
    Serial.println("----------------");

    delay(2000);
}
