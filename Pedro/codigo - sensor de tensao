#include <ZMPT101B.h>

// Valor de calibração/sensibilidade
#define SENSITIVITY 500.0f

// GPIO34 e frequência da rede
ZMPT101B voltageSensor(34, 60.0);

void setup() {
    Serial.begin(115200);

    // Define a calibração do sensor
    voltageSensor.setSensitivity(SENSITIVITY);

    delay(2000);
}

void loop() {
    // Calcula a tensão RMS
    float voltage = voltageSensor.getRmsVoltage();

    Serial.print("Tensao RMS: ");
    Serial.print(voltage, 2);
    Serial.println(" V");

    delay(1000);
}
