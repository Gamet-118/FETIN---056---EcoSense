            if linha:
                partes = linha.split(',')
                
                if len(partes) == 5:
                    try:
                        corrente_bruta = float(partes[0])
                        tensao = float(partes[1])
                        energia = float(partes[3])
                        dispositivo = partes[4]

                        # --- ALTERNATIVA 2 APLICADA AQUI ---
                        # Se a corrente lida for menor ou igual ao ruído, consideramos 0
                        if corrente_bruta <= (OFFSET_RUIDO + 0.05):
                            corrente_real = 0.0
                        else:
                            corrente_real = corrente_bruta - OFFSET_RUIDO

                        # Recalcula a potência com a corrente tratada
                        potencia_real = corrente_real * tensao
                        # -----------------------------------

