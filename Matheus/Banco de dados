import serial
import sqlite3
import time
import datetime

# =====================================================
# CONFIGURAÇÕES
# =====================================================

PORTA_SERIAL = "/dev/ttyUSB0"
BAUD_RATE = 115200

DB_PATH = "/home/pedro/ProjetoEnergia/banco/energia.db"

NOME_DISPOSITIVO = "ESP32_01"

# Ruído medido com a lâmpada desligada
OFFSET_RUIDO = 0.78

# Margem para evitar pequenas oscilações
MARGEM_RUIDO = 0.05


# =====================================================
# CONEXÃO COM O BANCO
# =====================================================

def conectar_banco():

    conn = sqlite3.connect(DB_PATH)

    cursor = conn.cursor()

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS leituras (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            corrente REAL NOT NULL,
            tensao REAL NOT NULL,
            potencia REAL NOT NULL,
            energia REAL NOT NULL,
            dispositivo TEXT NOT NULL,
            data_hora TEXT NOT NULL
        )
    """)

    conn.commit()

    return conn


# =====================================================
# SALVAR LEITURA
# =====================================================

def salvar_leitura(
    conn,
    corrente,
    tensao,
    potencia,
    energia
):

    cursor = conn.cursor()

    data_hora = datetime.datetime.now().strftime(
        "%Y-%m-%d %H:%M:%S"
    )
    
    print("banco tentando salvar")

    cursor.execute("""
        INSERT INTO leituras
        (
            corrente,
            tensao,
            potencia,
            energia,
            dispositivo,
            data_hora
        )
        VALUES (?, ?, ?, ?, ?, ?)
    """,
    (
        corrente,
        tensao,
        potencia,
        energia,
        NOME_DISPOSITIVO,
        data_hora
    ))

    conn.commit()
    
    print("salvou")


# =====================================================
# CONECTAR SERIAL
# =====================================================

def conectar_serial():

    while True:

        try:

            ser = serial.Serial(
                PORTA_SERIAL,
                BAUD_RATE,
                timeout=2
            )

            print(
                f"Conectado à porta "
                f"{PORTA_SERIAL} ({BAUD_RATE} bps)"
            )

            return ser

        except Exception as e:

            print(
                f"[Erro] Não foi possível abrir "
                f"a porta serial: {e}"
            )

            print("Tentando novamente em 5 segundos...")

            time.sleep(5)


# =====================================================
# INTERPRETAR DADOS DO ESP32
# =====================================================

def interpretar_linha(linha):

    partes = linha.strip().split(",")

    if len(partes) != 4:

        raise ValueError(
            f"Formato inesperado: '{linha}'"
        )

    corrente_bruta = float(partes[0])

    tensao = float(partes[1])
    
    potencia_esp = float(partes[2])

    dispositivo = partes[3]

    # =================================================
    # CORREÇÃO DO RUÍDO
    # =================================================

    if corrente_bruta <= (OFFSET_RUIDO + MARGEM_RUIDO):

        corrente_real = 0.0

    else:

        corrente_real = corrente_bruta - OFFSET_RUIDO


    # =================================================
    # CÁLCULO DA POTÊNCIA
    # =================================================

    potencia = corrente_real * tensao


    return corrente_real, tensao, potencia, dispositivo


# =====================================================
# PROGRAMA PRINCIPAL
# =====================================================

def main():

    print("=========================================")
    print("EcoSense")
    print("Coletor de leituras iniciado")
    print("=========================================")

    conn = conectar_banco()

    ser = conectar_serial()


    # Horário da primeira leitura
    horario_ultima_leitura = time.time()


    try:

        while True:

            try:

                linha_bruta = ser.readline().decode(
                    "utf-8",
                    errors="ignore"
                )
                
                print("DADO RECEBIDO: ",linha_bruta)


                if not linha_bruta.strip():

                    continue


                # =====================================
                # INTERPRETA DADOS
                # =====================================

                (
                    corrente,
                    tensao,
                    potencia,
                    dispositivo
                ) = interpretar_linha(linha_bruta)


                # =====================================
                # CALCULAR ENERGIA
                # =====================================

                agora = time.time()

                intervalo_horas = (
                    agora - horario_ultima_leitura
                ) / 3600

                energia_incremental = (
                    potencia * intervalo_horas
                ) / 1000

                horario_ultima_leitura = agora


                # =====================================
                # SALVAR NO BANCO
                # =====================================

                salvar_leitura(
                    conn,
                    corrente,
                    tensao,
                    potencia,
                    energia_incremental
                )


                # =====================================
                # MOSTRAR NO TERMINAL
                # =====================================

                print(
                    f"[{datetime.datetime.now().strftime('%H:%M:%S')}] "
                    f"Dispositivo: {dispositivo} | "
                    f"Corrente: {corrente:.2f} A | "
                    f"Tensão: {tensao:.2f} V | "
                    f"Potência: {potencia:.2f} W | "
                    f"Energia: {energia_incremental:.5f} kWh"
                )


            except ValueError as e:

                print(
                    f"[Aviso] Leitura ignorada: {e}"
                )


            except serial.SerialException as e:

                print(
                    f"[Erro] Conexão serial perdida: {e}"
                )

                ser.close()

                ser = conectar_serial()


    except KeyboardInterrupt:

        print(
            "\nColetor encerrado manualmente."
        )


    finally:

        ser.close()

        conn.close()


# =====================================================
# INICIAR
# =====================================================

if __name__ == "__main__":

    main()
