import serial
import sqlite3
import time
import datetime

# =====================================================
# CONFIGURAÇÕES
# =====================================================
PORTA_SERIAL = "/dev/ttyUSB0"   # No Raspberry Pi costuma ser /dev/ttyUSB0 ou /dev/ttyACM0
                                  # (no Windows seria "COM3", como no seu app.py)
BAUD_RATE = 9600                 # Precisa ser IGUAL à velocidade configurada no código do ESP32
DB_PATH = "/home/pedro/ProjetoEnergia/banco/energia.db"
NOME_DISPOSITIVO = "ESP32_01"

# =====================================================
# CONEXÃO COM O BANCO
# =====================================================
def conectar_banco():
    """Abre uma conexão com o banco e garante que a tabela exista."""
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS leituras (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            corrente REAL NOT NULL,
            tensao REAL NOT NULL,
            potencia REAL NOT NULL,
            energia REAL NOT NULL,
            dispositivo TEXT NOT NULL,
            data_hora TEXT NOT NULL
        )
    """)
    conn.commit()
    return conn


def salvar_leitura(conn, corrente, tensao, potencia, energia_incremental):
    """Grava uma nova linha na tabela leituras."""
    cursor = conn.cursor()
    data_hora = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    cursor.execute("""
        INSERT INTO leituras (corrente, tensao, potencia, energia, dispositivo, data_hora)
        VALUES (?, ?, ?, ?, ?, ?)
    """, (corrente, tensao, potencia, energia_incremental, NOME_DISPOSITIVO, data_hora))
    conn.commit()  # ESSENCIAL: sem isso, nada é realmente salvo no arquivo do banco


# =====================================================
# CONEXÃO COM A PORTA SERIAL (com tentativas automáticas)
# =====================================================
def conectar_serial():
    """Tenta abrir a porta serial. Se falhar, tenta de novo a cada 5 segundos."""
    while True:
        try:
            ser = serial.Serial(PORTA_SERIAL, BAUD_RATE, timeout=2)
            print(f"Conectado à porta serial {PORTA_SERIAL} ({BAUD_RATE} bps)")
            return ser
        except Exception as e:
            print(f"[Erro] Não foi possível abrir a porta serial: {e}")
            print("Tentando novamente em 5 segundos...")
            time.sleep(5)


# =====================================================
# INTERPRETAÇÃO DA LINHA RECEBIDA DO ESP32
# =====================================================
# ATENÇÃO: esta função depende do formato exato que o ESP32 envia.
# Aqui estou assumindo que o ESP32 manda uma linha de texto simples,
# separada por vírgula, no formato:
#
#     corrente,tensao
#
# Exemplo de linha real recebida: "2.53,219.80"
#
# Se o seu ESP32 manda em outro formato (JSON, só a corrente, com
# outro separador, etc.), é só ajustar a lógica AQUI DENTRO — o resto
# do script (banco, cálculo de energia, loop principal) não muda.
def interpretar_linha(linha):
    partes = linha.strip().split(",")
    if len(partes) < 2:
        raise ValueError(f"Linha em formato inesperado: '{linha}'")
    corrente = float(partes[0])
    tensao = float(partes[1])
    return corrente, tensao


# =====================================================
# LOOP PRINCIPAL
# =====================================================
def main():
    print("=========================================")
    print("EcoSense — Coletor de leituras iniciado")
    print("=========================================")

    conn = conectar_banco()
    ser = conectar_serial()

    # Guarda o horário da última leitura válida, pra calcular quanto
    # tempo passou entre uma leitura e outra (necessário pra estimar
    # a energia consumida nesse intervalo, em kWh)
    horario_ultima_leitura = time.time()

    try:
        while True:
            try:
                linha_bruta = ser.readline().decode("utf-8", errors="ignore")

                # Se a serial não mandou nada nesse intervalo (linha vazia),
                # simplesmente tenta de novo no próximo ciclo
                if not linha_bruta.strip():
                    continue

                corrente, tensao = interpretar_linha(linha_bruta)
                potencia = corrente * tensao  # P = V * I, em Watts

                # ---- Cálculo da energia consumida neste intervalo ----
                agora = time.time()
                intervalo_horas = (agora - horario_ultima_leitura) / 3600
                energia_incremental = (potencia * intervalo_horas) / 1000  # Wh -> kWh
                horario_ultima_leitura = agora

                salvar_leitura(conn, corrente, tensao, potencia, energia_incremental)

                print(f"[{datetime.datetime.now().strftime('%H:%M:%S')}] "
                      f"Corrente: {corrente:.2f} A | Tensão: {tensao:.2f} V | "
                      f"Potência: {potencia:.2f} W | Energia: {energia_incremental:.5f} kWh")

            except ValueError as e:
                # Linha veio corrompida ou em formato errado — ignora e segue,
                # sem derrubar o programa por causa de UMA leitura ruim
                print(f"[Aviso] Leitura ignorada: {e}")

            except serial.SerialException as e:
                # Perdeu a conexão com a porta serial (ex: cabo desconectado)
                print(f"[Erro] Conexão serial perdida: {e}")
                ser.close()
                ser = conectar_serial()  # tenta reconectar automaticamente

    except KeyboardInterrupt:
        print("\nColetor encerrado manualmente.")

    finally:
        ser.close()
        conn.close()


if __name__ == "__main__":
    main()


